{
  "name": "jarvis-os",
  "version": "0.5.0",
  "private": true,
  "description": "Jarvis OS — pannello domotico a muro (PWA) per Home Assistant",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/dopo-build.mjs",
    "anteprima": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "formatta": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "verifica": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "home-assistant-js-websocket": "^9.7.0",
    "lit": "^3.3.3",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
