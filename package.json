{
  "name": "jarvis-os",
  "version": "0.6.4",
  "private": true,
  "description": "Jarvis OS — pannello domotico a muro (PWA) per Home Assistant",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/dopo-build.mjs",
    "anteprima": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "formatta": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "verifica": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e",
    "test:diagnostica": "node scripts/test-modulo.mjs diagnostica",
    "test:comune": "node scripts/test-modulo.mjs comune",
    "test:interfaccia": "node scripts/test-modulo.mjs interfaccia",
    "test:connessione": "node scripts/test-modulo.mjs connessione",
    "test:pwa": "node scripts/test-modulo.mjs pwa",
    "test:casa": "node scripts/test-modulo.mjs casa",
    "test:voce": "node scripts/test-modulo.mjs voce",
    "test:parola": "node scripts/test-modulo.mjs parola",
    "test:assistente": "node scripts/test-modulo.mjs assistente",
    "test:timer": "node scripts/test-modulo.mjs timer",
    "test:annunci": "node scripts/test-modulo.mjs annunci",
    "test:fotocamera": "node scripts/test-modulo.mjs fotocamera",
    "test:musica": "node scripts/test-modulo.mjs musica",
    "test:meteo": "node scripts/test-modulo.mjs meteo",
    "test:clima": "node scripts/test-modulo.mjs clima",
    "test:scene": "node scripts/test-modulo.mjs scene",
    "test:spesa": "node scripts/test-modulo.mjs spesa",
    "test:avvisi": "node scripts/test-modulo.mjs avvisi",
    "test:riposo": "node scripts/test-modulo.mjs riposo",
    "test:hub": "node scripts/test-modulo.mjs hub",
    "test:navigazione": "node scripts/test-modulo.mjs navigazione",
    "test:impostazioni": "node scripts/test-modulo.mjs impostazioni",
    "test:app": "node scripts/test-modulo.mjs app"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "home-assistant-js-websocket": "^9.7.0",
    "lit": "^3.3.3",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
